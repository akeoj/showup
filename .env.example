# Copy to .env.local and fill in from your Supabase project settings → API.
# The anon key is safe in the client: every table is protected by RLS.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base URL used when building share links (no trailing slash).
# Leave blank to use window.location.origin.
VITE_PUBLIC_URL=
